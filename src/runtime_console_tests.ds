    proc run_all_tests() -> UInt32 {
        let passed = 0;
        
        passed = passed + RuntimeConsoleTests::test_k_putchar();
        passed = passed + RuntimeConsoleTests::test_k_puts();
        passed = passed + RuntimeConsoleTests::test_k_getchar();
        passed = passed + RuntimeConsoleTests::test_k_clear();
        passed = passed + RuntimeConsoleTests::test_k_set_cursor();
        passed = passed + RuntimeConsoleTests::test_k_get_cursor_row();
        passed = passed + RuntimeConsoleTests::test_k_get_cursor_col();
        passed = passed + RuntimeConsoleTests::test_k_scroll();
        passed = passed + RuntimeConsoleTests::test_k_set_color();
        passed = passed + RuntimeConsoleTests::test_q_putchar_returns_error();
        passed = passed + RuntimeConsoleTests::test_q_puts_returns_error();
        passed = passed + RuntimeConsoleTests::test_q_getchar_returns_error();
        passed = passed + RuntimeConsoleTests::test_q_clear_returns_error();
        passed = passed + RuntimeConsoleTests::test_q_set_cursor_returns_error();
        passed = passed + RuntimeConsoleTests::test_q_get_cursor_row();
        passed = passed + RuntimeConsoleTests::test_q_get_cursor_col();
        passed = passed + RuntimeConsoleTests::test_q_scroll_returns_error();
        passed = passed + RuntimeConsoleTests::test_q_set_color_returns_error();
        passed = passed + RuntimeConsoleTests::test_phi_putchar_returns_error();
        passed = passed + RuntimeConsoleTests::test_phi_puts_returns_error();
        passed = passed + RuntimeConsoleTests::test_phi_getchar_returns_error();
        passed = passed + RuntimeConsoleTests::test_phi_clear_returns_error();
        passed = passed + RuntimeConsoleTests::test_phi_set_cursor_returns_error();
        passed = passed + RuntimeConsoleTests::test_phi_get_cursor_row();
        passed = passed + RuntimeConsoleTests::test_phi_get_cursor_col();
        passed = passed + RuntimeConsoleTests::test_phi_scroll_returns_error();
        passed = passed + RuntimeConsoleTests::test_phi_set_color_returns_error();
        
        return passed;
    }
