// Runtime Console Tests

forge RuntimeConsoleTests {
    
    proc test_k_putchar() -> UInt32 {
        let result = RuntimeConsole::K::putchar(65);
        return 1;
    }
    
    proc test_k_puts() -> UInt32 {
        let result = RuntimeConsole::K::puts(0);
        return 1;
    }
    
    proc test_k_getchar() -> UInt32 {
        let result = RuntimeConsole::K::getchar();
        return 1;
    }
    
    proc test_k_clear() -> UInt32 {
        let result = RuntimeConsole::K::clear();
        return 1;
    }
    
    proc test_k_set_cursor() -> UInt32 {
        let result = RuntimeConsole::K::set_cursor(10, 20);
        return 1;
    }
    
    proc test_k_get_cursor_row() -> UInt32 {
        let result = RuntimeConsole::K::get_cursor_row();
        return 1;
    }
    
    proc test_k_get_cursor_col() -> UInt32 {
        let result = RuntimeConsole::K::get_cursor_col();
        return 1;
    }
    
    proc test_k_scroll() -> UInt32 {
        let result = RuntimeConsole::K::scroll();
        return 1;
    }
    
    proc test_k_set_color() -> UInt32 {
        let result = RuntimeConsole::K::set_color(15, 0);
        return 1;
    }
    
    proc test_q_putchar_returns_error() -> UInt32 {
        let result = RuntimeConsole::Q::putchar(65);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_q_puts_returns_error() -> UInt32 {
