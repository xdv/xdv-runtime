// Description:
//   Runtime FS - File System Interface (wraps xdvfs)

forge RuntimeFsErrors {
    const ERR_OK: UInt32 = 0;
    const ERR_MOUNT_FAILED: UInt32 = 1;
    const ERR_UMOUNT_FAILED: UInt32 = 2;
    const ERR_OPEN_FAILED: UInt32 = 3;
    const ERR_READ_FAILED: UInt32 = 4;
    const ERR_WRITE_FAILED: UInt32 = 5;
    const ERR_CLOSE_FAILED: UInt32 = 6;
    const ERR_NOT_FOUND: UInt32 = 7;
    const ERR_EXISTS: UInt32 = 8;
    const ERR_IS_DIRECTORY: UInt32 = 9;
    const ERR_NOT_DIRECTORY: UInt32 = 10;
    const ERR_PERMISSION: UInt32 = 11;
    const ERR_NO_SPACE: UInt32 = 12;
    const ERR_DOMAIN_NOT_AVAILABLE: UInt32 = 100;
}

forge RuntimeFs {

    const MAX_OPEN_FILES: UInt32 = 64;
    const MAX_PATH_LEN: UInt32 = 256;

    const FILE_FLAG_READ: UInt32 = 0;
    const FILE_FLAG_WRITE: UInt32 = 1;
    const FILE_FLAG_APPEND: UInt32 = 2;

    const NULL_HANDLE: UInt64 = 0;
    const IO_OK: UInt32 = 0;

    proc K::mount(device: UInt64, mount_point: UInt64) -> UInt32 {
        if device == 0 {
            return ERR_MOUNT_FAILED;
        } else {
            if mount_point == 0 {
                return ERR_MOUNT_FAILED;
            } else {
                emit "runtime-fs mount";
                return ERR_OK;
            }
        }
    }

    proc K::umount(mount_point: UInt64) -> UInt32 {
        if mount_point == 0 {
            return ERR_UMOUNT_FAILED;
        } else {
            emit "runtime-fs umount";
            return ERR_OK;
        }
    }

    proc K::open_file(path: UInt64, flags: UInt32) -> UInt64 {
        if path == 0 {
            return NULL_HANDLE;
        } else {
            if flags > FILE_FLAG_APPEND {
                return NULL_HANDLE;
            } else {
                return file_open(path, flags);
            }
        }
    }

    proc K::read_file(fd: UInt64, buffer: UInt64, size: UInt32) -> UInt32 {
        if fd == NULL_HANDLE {
            return ERR_READ_FAILED;
        } else {
            if buffer == 0 {
                return ERR_READ_FAILED;
            } else {
                if size == 0 {
                    return ERR_OK;
                } else {
                    let read_status = file_read(fd, buffer, size);
                    if read_status == IO_OK {
                        return ERR_OK;
                    } else {
                        return ERR_READ_FAILED;
                    }
                }
            }
        }
    }

    proc K::write_file(fd: UInt64, buffer: UInt64, size: UInt32) -> UInt32 {
        if fd == NULL_HANDLE {
            return ERR_WRITE_FAILED;
        } else {
            if buffer == 0 {
                return ERR_WRITE_FAILED;
            } else {
                if size == 0 {
                    return ERR_OK;
                } else {
                    let write_status = file_write(fd, buffer, size);
                    if write_status == IO_OK {
                        return ERR_OK;
                    } else {
                        return ERR_WRITE_FAILED;
                    }
                }
            }
        }
    }

    proc K::close_file(fd: UInt64) -> UInt32 {
        if fd == NULL_HANDLE {
            return ERR_CLOSE_FAILED;
        } else {
            let close_status = file_close(fd);
            if close_status == IO_OK {
                return ERR_OK;
            } else {
                return ERR_CLOSE_FAILED;
            }
        }
    }

    proc K::stat(path: UInt64, stat_buf: UInt64) -> UInt32 {
        if path == 0 {
            return ERR_NOT_FOUND;
        } else {
            if stat_buf == 0 {
                return ERR_READ_FAILED;
            } else {
                return ERR_OK;
            }
        }
    }

    proc K::mkdir(path: UInt64, mode: UInt32) -> UInt32 {
        if path == 0 {
            return ERR_NOT_FOUND;
        } else {
            if mode == 0 {
                return ERR_PERMISSION;
            } else {
                return ERR_OK;
            }
        }
    }

    proc K::rmdir(path: UInt64) -> UInt32 {
        if path == 0 {
            return ERR_NOT_DIRECTORY;
        } else {
            return ERR_OK;
        }
    }

    proc K::unlink_path(path: UInt64) -> UInt32 {
        if path == 0 {
            return ERR_NOT_FOUND;
        } else {
            return ERR_OK;
        }
    }

    proc K::readdir(dir: UInt64, entry: UInt64) -> UInt32 {
        if dir == 0 {
            return ERR_NOT_DIRECTORY;
        } else {
            if entry == 0 {
                return ERR_READ_FAILED;
            } else {
                return ERR_OK;
            }
        }
    }

    proc K::is_supported_flag(flag: UInt32) -> UInt32 {
        if flag > FILE_FLAG_APPEND {
            return ERR_OPEN_FAILED;
        } else {
            return ERR_OK;
        }
    }
}