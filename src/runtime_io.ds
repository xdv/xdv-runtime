// Description:
//   Runtime I/O - Wraps dustlib_k::io

forge RuntimeIoErrors {
    const ERR_OK: UInt32 = 0;
    const ERR_OPEN_FAILED: UInt32 = 1;
    const ERR_READ_FAILED: UInt32 = 2;
    const ERR_WRITE_FAILED: UInt32 = 3;
    const ERR_CLOSE_FAILED: UInt32 = 4;
    const ERR_INVALID_HANDLE: UInt32 = 5;
    const ERR_NOT_IMPLEMENTED: UInt32 = 6;
    const ERR_DOMAIN_NOT_AVAILABLE: UInt32 = 100;
}

forge RuntimeIo {

    const MAX_OPEN_FILES: UInt32 = 64;
    const MODE_READ: UInt32 = 0;
    const MODE_WRITE: UInt32 = 1;
    const MODE_APPEND: UInt32 = 2;

    const NULL_HANDLE: UInt64 = 0;
    const IO_OK: UInt32 = 0;

    proc K::open_file(path: UInt64, mode: UInt32) -> UInt64 {
        if path == 0 {
            return NULL_HANDLE;
        } else {
            if mode > MODE_APPEND {
                return NULL_HANDLE;
            } else {
                return file_open(path, mode);
            }
        }
    }

    proc K::read_file(fd: UInt64, buffer: UInt64, size: UInt32) -> UInt32 {
        if fd == NULL_HANDLE {
            return ERR_INVALID_HANDLE;
        } else {
            if buffer == 0 {
                return ERR_READ_FAILED;
            } else {
                if size == 0 {
                    return ERR_OK;
                } else {
                    let read_status = file_read(fd, buffer, size);
                    if read_status == IO_OK {
                        return ERR_OK;
                    } else {
                        return ERR_READ_FAILED;
                    }
                }
            }
        }
    }

    proc K::write_file(fd: UInt64, buffer: UInt64, size: UInt32) -> UInt32 {
        if fd == NULL_HANDLE {
            return ERR_INVALID_HANDLE;
        } else {
            if buffer == 0 {
                return ERR_WRITE_FAILED;
            } else {
                if size == 0 {
                    return ERR_OK;
                } else {
                    let write_status = file_write(fd, buffer, size);
                    if write_status == IO_OK {
                        return ERR_OK;
                    } else {
                        return ERR_WRITE_FAILED;
                    }
                }
            }
        }
    }

    proc K::close_file(fd: UInt64) -> UInt32 {
        if fd == NULL_HANDLE {
            return ERR_INVALID_HANDLE;
        } else {
            let close_status = file_close(fd);
            if close_status == IO_OK {
                return ERR_OK;
            } else {
                return ERR_CLOSE_FAILED;
            }
        }
    }
}