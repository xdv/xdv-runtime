// Runtime Process Tests

forge RuntimeProcessTests {
    
    proc test_k_spawn() -> UInt32 {
        let result = RuntimeProcess::K::spawn(0, 4096);
        return 1;
    }
    
    proc test_k_join() -> UInt32 {
        let result = RuntimeProcess::K::join(0);
        return 1;
    }
    
    proc test_k_exit() -> UInt32 {
        let result = RuntimeProcess::K::exit(0, 0);
        return 1;
    }
    
    proc test_k_getpid() -> UInt32 {
        let result = RuntimeProcess::K::getpid();
        if result == 1 {
            return 1;
        }
        return 0;
    }
    
    proc test_k_sleep() -> UInt32 {
        let result = RuntimeProcess::K::sleep(1000);
        return 1;
    }
    
    proc test_k_yield() -> UInt32 {
        let result = RuntimeProcess::K::yield();
        return 1;
    }
    
    proc test_q_spawn_returns_error() -> UInt32 {
        let result = RuntimeProcess::Q::spawn(0, 4096);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_q_join() -> UInt32 {
        let result = RuntimeProcess::Q::join(0);
        return 1;
    }
    
    proc test_q_exit_returns_error() -> UInt32 {
        let result = RuntimeProcess::Q::exit(0, 0);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_q_getpid() -> UInt32 {
        let result = RuntimeProcess::Q::getpid();
        if result == 1 {
            return 1;
        }
        return 0;
    }
    
    proc test_q_sleep_returns_error() -> UInt32 {
        let result = RuntimeProcess::Q::sleep(1000);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_q_yield_returns_error() -> UInt32 {
        let result = RuntimeProcess::Q::yield();
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_phi_spawn_returns_error() -> UInt32 {
        let result = RuntimeProcess::Phi::spawn(0, 4096);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_phi_join() -> UInt32 {
        let result = RuntimeProcess::Phi::join(0);
        return 1;
    }
    
    proc test_phi_exit_returns_error() -> UInt32 {
        let result = RuntimeProcess::Phi::exit(0, 0);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_phi_getpid() -> UInt32 {
        let result = RuntimeProcess::Phi::getpid();
        if result == 1 {
            return 1;
        }
        return 0;
    }
    
    proc test_phi_sleep_returns_error() -> UInt32 {
        let result = RuntimeProcess::Phi::sleep(1000);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_phi_yield_returns_error() -> UInt32 {
        let result = RuntimeProcess::Phi::yield();
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc run_all_tests() -> UInt32 {
        let passed = 0;
        
        passed = passed + RuntimeProcessTests::test_k_spawn();
        passed = passed + RuntimeProcessTests::test_k_join();
        passed = passed + RuntimeProcessTests::test_k_exit();
        passed = passed + RuntimeProcessTests::test_k_getpid();
        passed = passed + RuntimeProcessTests::test_k_sleep();
        passed = passed + RuntimeProcessTests::test_k_yield();
        passed = passed + RuntimeProcessTests::test_q_spawn_returns_error();
        passed = passed + RuntimeProcessTests::test_q_join();
        passed = passed + RuntimeProcessTests::test_q_exit_returns_error();
        passed = passed + RuntimeProcessTests::test_q_getpid();
        passed = passed + RuntimeProcessTests::test_q_sleep_returns_error();
        passed = passed + RuntimeProcessTests::test_q_yield_returns_error();
        passed = passed + RuntimeProcessTests::test_phi_spawn_returns_error();
        passed = passed + RuntimeProcessTests::test_phi_join();
        passed = passed + RuntimeProcessTests::test_phi_exit_returns_error();
        passed = passed + RuntimeProcessTests::test_phi_getpid();
        passed = passed + RuntimeProcessTests::test_phi_sleep_returns_error();
        passed = passed + RuntimeProcessTests::test_phi_yield_returns_error();
        
        return passed;
    }
}
