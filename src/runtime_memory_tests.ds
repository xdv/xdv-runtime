// Runtime Memory Tests

forge RuntimeMemoryTests {
    
    proc test_k_alloc() -> UInt32 {
        let result = RuntimeMemory::K::alloc(1024);
        return 1;
    }
    
    proc test_k_free() -> UInt32 {
        let result = RuntimeMemory::K::free(0);
        return 1;
    }
    
    proc test_k_zero_alloc() -> UInt32 {
        let result = RuntimeMemory::K::zero_alloc(1024);
        return 1;
    }
    
    proc test_k_copy() -> UInt32 {
        let result = RuntimeMemory::K::copy(0, 0, 1024);
        return 1;
    }
    
    proc test_k_set() -> UInt32 {
        let result = RuntimeMemory::K::set(0, 0, 1024);
        return 1;
    }
    
    proc test_q_alloc() -> UInt32 {
        let result = RuntimeMemory::Q::alloc(1024);
        return 1;
    }
    
    proc test_q_free_returns_error() -> UInt32 {
        let result = RuntimeMemory::Q::free(0);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_q_zero_alloc() -> UInt32 {
        let result = RuntimeMemory::Q::zero_alloc(1024);
        return 1;
    }
    
    proc test_q_copy_returns_error() -> UInt32 {
        let result = RuntimeMemory::Q::copy(0, 0, 1024);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_q_set_returns_error() -> UInt32 {
        let result = RuntimeMemory::Q::set(0, 0, 1024);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_phi_alloc() -> UInt32 {
        let result = RuntimeMemory::Phi::alloc(1024);
        return 1;
    }
    
    proc test_phi_free_returns_error() -> UInt32 {
        let result = RuntimeMemory::Phi::free(0);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_phi_zero_alloc() -> UInt32 {
        let result = RuntimeMemory::Phi::zero_alloc(1024);
        return 1;
    }
    
    proc test_phi_copy_returns_error() -> UInt32 {
        let result = RuntimeMemory::Phi::copy(0, 0, 1024);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_phi_set_returns_error() -> UInt32 {
        let result = RuntimeMemory::Phi::set(0, 0, 1024);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc run_all_tests() -> UInt32 {
        let passed = 0;
        
        passed = passed + RuntimeMemoryTests::test_k_alloc();
        passed = passed + RuntimeMemoryTests::test_k_free();
        passed = passed + RuntimeMemoryTests::test_k_zero_alloc();
        passed = passed + RuntimeMemoryTests::test_k_copy();
        passed = passed + RuntimeMemoryTests::test_k_set();
        passed = passed + RuntimeMemoryTests::test_q_alloc();
        passed = passed + RuntimeMemoryTests::test_q_free_returns_error();
        passed = passed + RuntimeMemoryTests::test_q_zero_alloc();
        passed = passed + RuntimeMemoryTests::test_q_copy_returns_error();
        passed = passed + RuntimeMemoryTests::test_q_set_returns_error();
        passed = passed + RuntimeMemoryTests::test_phi_alloc();
        passed = passed + RuntimeMemoryTests::test_phi_free_returns_error();
        passed = passed + RuntimeMemoryTests::test_phi_zero_alloc();
        passed = passed + RuntimeMemoryTests::test_phi_copy_returns_error();
        passed = passed + RuntimeMemoryTests::test_phi_set_returns_error();
        
        return passed;
    }
}
