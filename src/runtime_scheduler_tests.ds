    proc run_all_tests() -> UInt32 {
        let passed = 0;
        
        passed = passed + RuntimeSchedulerTests::test_k_init();
        passed = passed + RuntimeSchedulerTests::test_k_start();
        passed = passed + RuntimeSchedulerTests::test_k_stop();
        passed = passed + RuntimeSchedulerTests::test_k_add_task();
        passed = passed + RuntimeSchedulerTests::test_k_remove_task();
        passed = passed + RuntimeSchedulerTests::test_k_set_priority();
        passed = passed + RuntimeSchedulerTests::test_k_get_current_task();
        passed = passed + RuntimeSchedulerTests::test_k_schedule();
        passed = passed + RuntimeSchedulerTests::test_q_init_returns_error();
        passed = passed + RuntimeSchedulerTests::test_q_start_returns_error();
        passed = passed + RuntimeSchedulerTests::test_q_stop_returns_error();
        passed = passed + RuntimeSchedulerTests::test_q_add_task_returns_error();
        passed = passed + RuntimeSchedulerTests::test_q_remove_task_returns_error();
        passed = passed + RuntimeSchedulerTests::test_q_set_priority_returns_error();
        passed = passed + RuntimeSchedulerTests::test_q_get_current_task();
        passed = passed + RuntimeSchedulerTests::test_q_schedule_returns_error();
        passed = passed + RuntimeSchedulerTests::test_phi_init_returns_error();
        passed = passed + RuntimeSchedulerTests::test_phi_start_returns_error();
        passed = passed + RuntimeSchedulerTests::test_phi_stop_returns_error();
        passed = passed + RuntimeSchedulerTests::test_phi_add_task_returns_error();
        passed = passed + RuntimeSchedulerTests::test_phi_remove_task_returns_error();
        passed = passed + RuntimeSchedulerTests::test_phi_set_priority_returns_error();
        passed = passed + RuntimeSchedulerTests::test_phi_get_current_task();
        passed = passed + RuntimeSchedulerTests::test_phi_schedule_returns_error();
        
        return passed;
