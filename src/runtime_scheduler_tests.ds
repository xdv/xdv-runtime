// Runtime Scheduler Tests

forge RuntimeSchedulerTests {
    
    proc test_k_init() -> UInt32 {
        let result = RuntimeScheduler::K::init();
        return 1;
    }
    
    proc test_k_start() -> UInt32 {
        let result = RuntimeScheduler::K::start();
        return 1;
    }
    
    proc test_k_stop() -> UInt32 {
        let result = RuntimeScheduler::K::stop();
        return 1;
    }
    
    proc test_k_add_task() -> UInt32 {
        let result = RuntimeScheduler::K::add_task(2, 5);
        return 1;
    }
    
    proc test_k_remove_task() -> UInt32 {
        let result = RuntimeScheduler::K::remove_task(2);
        return 1;
    }
    
    proc test_k_set_priority() -> UInt32 {
        let result = RuntimeScheduler::K::set_priority(2, 7);
        return 1;
    }
    
    proc test_k_get_current_task() -> UInt32 {
        let result = RuntimeScheduler::K::get_current_task();
        if result == 1 {
            return 1;
        }
        return 0;
    }
    
    proc test_k_schedule() -> UInt32 {
        let result = RuntimeScheduler::K::schedule();
        return 1;
    }
    
