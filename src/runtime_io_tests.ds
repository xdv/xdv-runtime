// Runtime I/O Tests

forge RuntimeIoTests {
    
    proc test_k_open() -> UInt32 {
        let result = RuntimeIo::K::open(0, 0);
        if result == 0 {
            return 1;
        }
        return 0;
    }
    
    proc test_k_read() -> UInt32 {
        let result = RuntimeIo::K::read(0, 0, 0);
        return 1;
    }
    
    proc test_k_write() -> UInt32 {
        let result = RuntimeIo::K::write(0, 0, 0);
        return 1;
    }
    
    proc test_k_close() -> UInt32 {
        let result = RuntimeIo::K::close(0);
        return 1;
    }
    
    proc test_q_open() -> UInt32 {
        let result = RuntimeIo::Q::open(0, 0);
        return 1;
    }
    
    proc test_q_read_returns_error() -> UInt32 {
        let result = RuntimeIo::Q::read(0, 0, 0);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_q_write_returns_error() -> UInt32 {
        let result = RuntimeIo::Q::write(0, 0, 0);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_q_close_returns_error() -> UInt32 {
        let result = RuntimeIo::Q::close(0);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_phi_open() -> UInt32 {
        let result = RuntimeIo::Phi::open(0, 0);
        return 1;
    }
    
    proc test_phi_read_returns_error() -> UInt32 {
        let result = RuntimeIo::Phi::read(0, 0, 0);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_phi_write_returns_error() -> UInt32 {
        let result = RuntimeIo::Phi::write(0, 0, 0);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_phi_close_returns_error() -> UInt32 {
        let result = RuntimeIo::Phi::close(0);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc run_all_tests() -> UInt32 {
        let passed = 0;
        
        passed = passed + RuntimeIoTests::test_k_open();
        passed = passed + RuntimeIoTests::test_k_read();
        passed = passed + RuntimeIoTests::test_k_write();
        passed = passed + RuntimeIoTests::test_k_close();
        passed = passed + RuntimeIoTests::test_q_open();
        passed = passed + RuntimeIoTests::test_q_read_returns_error();
        passed = passed + RuntimeIoTests::test_q_write_returns_error();
        passed = passed + RuntimeIoTests::test_q_close_returns_error();
        passed = passed + RuntimeIoTests::test_phi_open();
        passed = passed + RuntimeIoTests::test_phi_read_returns_error();
        passed = passed + RuntimeIoTests::test_phi_write_returns_error();
        passed = passed + RuntimeIoTests::test_phi_close_returns_error();
        
        return passed;
    }
}
