// Runtime Process - Wraps dustlib_k::threading

forge RuntimeProcessErrors {
    const ERR_OK: UInt32 = 0;
    const ERR_SPAWN_FAILED: UInt32 = 1;
    const ERR_JOIN_FAILED: UInt32 = 2;
    const ERR_INVALID_PID: UInt32 = 3;
    const ERR_PROCESS_NOT_FOUND: UInt32 = 4;
    const ERR_OUT_OF_PIDS: UInt32 = 5;
    const ERR_DOMAIN_NOT_AVAILABLE: UInt32 = 100;
}

forge RuntimeProcess {
    
    const MAX_PROCESSES: UInt32 = 256;
    const INIT_PID: UInt32 = 1;
    
    proc K::spawn(entry: UInt64, stack_size: UInt32) -> UInt32 {
        return 0;
    }
    
    proc K::join(pid: UInt32) -> UInt64 {
        return 0;
    }
    
    proc K::exit(pid: UInt32, code: UInt32) -> UInt32 {
        return 0;
    }
    
    proc K::getpid() -> UInt32 {
        return 1;
    }
    
    proc K::sleep(ms: UInt32) -> UInt32 {
        return 0;
    }
    
    proc K::yield() -> UInt32 {
        return 0;
    }
    
    proc Q::spawn(entry: UInt64, stack_size: UInt32) -> UInt32 {
        return 100;
    }
    
