    proc Q::yield() -> UInt32 {
        return 100;
    }
    
    proc Phi::spawn(entry: UInt64, stack_size: UInt32) -> UInt32 {
        return 100;
    }
    
    proc Phi::join(pid: UInt32) -> UInt64 {
        return 0;
    }
    
    proc Phi::exit(pid: UInt32, code: UInt32) -> UInt32 {
