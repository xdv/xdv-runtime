        return 0;
    }
    
    proc Q::exit(pid: UInt32, code: UInt32) -> UInt32 {
        return 100;
    }
    
    proc Q::getpid() -> UInt32 {
        return 1;
    }
    
    proc Q::sleep(ms: UInt32) -> UInt32 {
        return 100;
