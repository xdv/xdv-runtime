// Runtime Process - Wraps dustlib_k::threading

forge RuntimeProcessErrors {
    const ERR_OK: UInt32 = 0;
    const ERR_SPAWN_FAILED: UInt32 = 1;
    const ERR_JOIN_FAILED: UInt32 = 2;
    const ERR_INVALID_PID: UInt32 = 3;
    const ERR_PROCESS_NOT_FOUND: UInt32 = 4;
    const ERR_OUT_OF_PIDS: UInt32 = 5;
    const ERR_SLEEP_FAILED: UInt32 = 6;
    const ERR_DOMAIN_NOT_AVAILABLE: UInt32 = 100;
}

forge RuntimeProcess {

    const MAX_PROCESSES: UInt32 = 256;
    const INIT_PID: UInt32 = 1;
    const MIN_STACK_SIZE: UInt32 = 4096;
    const MAX_STACK_SIZE: UInt32 = 1048576;
    const PID_BASE_SEED: UInt32 = 17;

    const NULL_PID: UInt32 = 0;
    const THREAD_OK: UInt32 = 0;

    proc K::spawn(entry: UInt64, stack_size: UInt32) -> UInt32 {
        if entry == 0 {
            return NULL_PID;
        } else {
            if stack_size < MIN_STACK_SIZE {
                return NULL_PID;
            } else {
                if stack_size > MAX_STACK_SIZE {
                    return NULL_PID;
                } else {
                    let process_status = process_init();
                    if process_status == ERR_OK {
                        let seed = stack_size + PID_BASE_SEED;
                        let pid = thread_spawn(INIT_PID, seed);
                        if pid == NULL_PID {
                            return NULL_PID;
                        } else {
                            return pid;
                        }
                    } else {
                        return NULL_PID;
                    }
                }
            }
        }
    }

    proc K::join(pid: UInt32) -> UInt64 {
        if pid == NULL_PID {
            return NULL_PID;
        } else {
            let join_status = thread_join(pid);
            if join_status == THREAD_OK {
                return pid;
            } else {
                return NULL_PID;
            }
        }
    }

    proc K::exit(pid: UInt32, code: UInt32) -> UInt32 {
        if pid == NULL_PID {
            return ERR_INVALID_PID;
        } else {
            let join_status = thread_join(pid);
            if join_status == THREAD_OK {
                return code;
            } else {
                return ERR_PROCESS_NOT_FOUND;
            }
        }
    }

    proc K::getpid() -> UInt32 {
        return INIT_PID;
    }

    proc K::sleep(ms: UInt32) -> UInt32 {
        let sleep_status = thread_sleep(ms);
        if sleep_status == THREAD_OK {
            return ERR_OK;
        } else {
            return ERR_SLEEP_FAILED;
        }
    }

    proc K::yield() -> UInt32 {
        return sleep(0);
    }

    proc K::spawn_with_limit(entry: UInt64, stack_size: UInt32, pid_limit: UInt32) -> UInt32 {
        if pid_limit == 0 {
            return NULL_PID;
        } else {
            if pid_limit > MAX_PROCESSES {
                return NULL_PID;
            } else {
                return spawn(entry, stack_size);
            }
        }
    }

    proc K::is_valid_pid(pid: UInt32) -> UInt32 {
        if pid == NULL_PID {
            return ERR_INVALID_PID;
        } else {
            let join_status = thread_join(pid);
            if join_status == THREAD_OK {
                return ERR_OK;
            } else {
                return ERR_PROCESS_NOT_FOUND;
            }
        }
    }
}
