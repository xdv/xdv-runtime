// Runtime Console - Console I/O

forge RuntimeConsoleErrors {
    const ERR_OK: UInt32 = 0;
    const ERR_INVALID_COORD: UInt32 = 1;
    const ERR_OUT_OF_RANGE: UInt32 = 2;
    const ERR_DOMAIN_NOT_AVAILABLE: UInt32 = 100;
}

forge RuntimeConsole {
    
    const VGA_ADDR: UInt64 = 18432;
    const VGA_WIDTH: UInt32 = 80;
    const VGA_HEIGHT: UInt32 = 25;
    const VGA_SIZE: UInt32 = 4000;
    
    const COLOR_BLACK: UInt8 = 0;
    const COLOR_BLUE: UInt8 = 1;
    const COLOR_GREEN: UInt8 = 2;
    const COLOR_CYAN: UInt8 = 3;
    const COLOR_RED: UInt8 = 4;
    const COLOR_MAGENTA: UInt8 = 5;
    const COLOR_BROWN: UInt8 = 6;
    const COLOR_LIGHT_GRAY: UInt8 = 7;
    const COLOR_DARK_GRAY: UInt8 = 8;
    const COLOR_LIGHT_BLUE: UInt8 = 9;
    const COLOR_LIGHT_GREEN: UInt8 = 10;
    const COLOR_LIGHT_CYAN: UInt8 = 11;
    const COLOR_LIGHT_RED: UInt8 = 12;
    const COLOR_LIGHT_MAGENTA: UInt8 = 13;
    const COLOR_YELLOW: UInt8 = 14;
    const COLOR_WHITE: UInt8 = 15;
    
    proc K::putchar(ch: UInt8) -> UInt32 {
        io_write(1016, ch);
        return ERR_OK;
    }
    
    proc K::puts(ptr: UInt64) -> UInt32 {
        if ptr == 0 {
            return ERR_OUT_OF_RANGE;
        } else {
            display_line(ptr);
            return ERR_OK;
        }
    }
    
    proc K::getchar() -> UInt32 {
        return io_read(960);
    }
    
    proc K::clear() -> UInt32 {
        return console_init();
    }
    
    proc K::set_cursor(row: UInt32, col: UInt32) -> UInt32 {
        if row >= VGA_HEIGHT {
            return ERR_INVALID_COORD;
        } else {
            if col >= VGA_WIDTH {
                return ERR_INVALID_COORD;
            } else {
                emit "runtime-console cursor move";
                return ERR_OK;
            }
        }
    }
    
    proc K::get_cursor_row() -> UInt32 {
        return 0;
    }
    
    proc K::get_cursor_col() -> UInt32 {
        return 0;
    }
    
    proc K::scroll() -> UInt32 {
        emit "runtime-console scroll";
        return ERR_OK;
    }
    
    proc K::set_color(fg: UInt8, bg: UInt8) -> UInt32 {
        if fg > COLOR_WHITE {
            return ERR_OUT_OF_RANGE;
        } else {
            if bg > COLOR_WHITE {
                return ERR_OUT_OF_RANGE;
            } else {
                emit "runtime-console color update";
                return ERR_OK;
            }
        }
    }
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
}


