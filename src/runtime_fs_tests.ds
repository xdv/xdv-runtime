    proc run_all_tests() -> UInt32 {
        let passed = 0;
        
        passed = passed + RuntimeFsTests::test_k_mount();
        passed = passed + RuntimeFsTests::test_k_umount();
        passed = passed + RuntimeFsTests::test_k_open();
        passed = passed + RuntimeFsTests::test_k_read();
        passed = passed + RuntimeFsTests::test_k_write();
        passed = passed + RuntimeFsTests::test_k_close();
        passed = passed + RuntimeFsTests::test_k_stat();
        passed = passed + RuntimeFsTests::test_k_mkdir();
        passed = passed + RuntimeFsTests::test_k_rmdir();
        passed = passed + RuntimeFsTests::test_k_unlink();
        passed = passed + RuntimeFsTests::test_k_readdir();
        passed = passed + RuntimeFsTests::test_q_mount_returns_error();
        passed = passed + RuntimeFsTests::test_q_umount_returns_error();
        passed = passed + RuntimeFsTests::test_q_open();
        passed = passed + RuntimeFsTests::test_q_read_returns_error();
        passed = passed + RuntimeFsTests::test_q_write_returns_error();
        passed = passed + RuntimeFsTests::test_q_close_returns_error();
        passed = passed + RuntimeFsTests::test_q_stat_returns_error();
        passed = passed + RuntimeFsTests::test_q_mkdir_returns_error();
        passed = passed + RuntimeFsTests::test_q_rmdir_returns_error();
        passed = passed + RuntimeFsTests::test_q_unlink_returns_error();
        passed = passed + RuntimeFsTests::test_q_readdir_returns_error();
        passed = passed + RuntimeFsTests::test_phi_mount_returns_error();
        passed = passed + RuntimeFsTests::test_phi_umount_returns_error();
        passed = passed + RuntimeFsTests::test_phi_open();
        passed = passed + RuntimeFsTests::test_phi_read_returns_error();
        passed = passed + RuntimeFsTests::test_phi_write_returns_error();
        passed = passed + RuntimeFsTests::test_phi_close_returns_error();
        passed = passed + RuntimeFsTests::test_phi_stat_returns_error();
        passed = passed + RuntimeFsTests::test_phi_mkdir_returns_error();
        passed = passed + RuntimeFsTests::test_phi_rmdir_returns_error();
        passed = passed + RuntimeFsTests::test_phi_unlink_returns_error();
        passed = passed + RuntimeFsTests::test_phi_readdir_returns_error();
        
