    proc run_all_tests() -> UInt32 {
        let passed = 0;
        
        passed = passed + RuntimeInitTests::test_k_main();
        passed = passed + RuntimeInitTests::test_k_init_fs();
        passed = passed + RuntimeInitTests::test_k_init_scheduler();
        passed = passed + RuntimeInitTests::test_k_init_console();
        passed = passed + RuntimeInitTests::test_k_spawn_shell();
        passed = passed + RuntimeInitTests::test_k_wait_for_child();
        passed = passed + RuntimeInitTests::test_k_reap_zombies();
        passed = passed + RuntimeInitTests::test_k_handle_signal();
        passed = passed + RuntimeInitTests::test_q_main_returns_error();
        passed = passed + RuntimeInitTests::test_q_init_fs_returns_error();
        passed = passed + RuntimeInitTests::test_q_init_scheduler_returns_error();
        passed = passed + RuntimeInitTests::test_q_init_console_returns_error();
        passed = passed + RuntimeInitTests::test_q_spawn_shell_returns_error();
        passed = passed + RuntimeInitTests::test_q_wait_for_child_returns_error();
        passed = passed + RuntimeInitTests::test_q_reap_zombies_returns_error();
        passed = passed + RuntimeInitTests::test_q_handle_signal_returns_error();
        passed = passed + RuntimeInitTests::test_phi_main_returns_error();
        passed = passed + RuntimeInitTests::test_phi_init_fs_returns_error();
        passed = passed + RuntimeInitTests::test_phi_init_scheduler_returns_error();
        passed = passed + RuntimeInitTests::test_phi_init_console_returns_error();
        passed = passed + RuntimeInitTests::test_phi_spawn_shell_returns_error();
        passed = passed + RuntimeInitTests::test_phi_wait_for_child_returns_error();
        passed = passed + RuntimeInitTests::test_phi_reap_zombies_returns_error();
