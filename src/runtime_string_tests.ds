// Runtime String Tests

forge RuntimeStringTests {
    
    proc test_k_len() -> UInt32 {
        let result = RuntimeString::K::len(0);
        return 1;
    }
    
    proc test_k_concat() -> UInt32 {
        let result = RuntimeString::K::concat(0, 0);
        return 1;
    }
    
    proc test_k_compare() -> UInt32 {
        let result = RuntimeString::K::compare(0, 0);
        return 1;
    }
    
    proc test_k_find() -> UInt32 {
        let result = RuntimeString::K::find(0, 0);
        return 1;
    }
    
    proc test_k_substring() -> UInt32 {
        let result = RuntimeString::K::substring(0, 0, 0);
        return 1;
    }
    
    proc test_k_to_upper() -> UInt32 {
        let result = RuntimeString::K::to_upper(0);
        return 1;
    }
    
    proc test_k_to_lower() -> UInt32 {
        let result = RuntimeString::K::to_lower(0);
        return 1;
    }
    
    proc test_q_len() -> UInt32 {
        let result = RuntimeString::Q::len(0);
        return 1;
    }
    
    proc test_q_concat_returns_error() -> UInt32 {
        let result = RuntimeString::Q::concat(0, 0);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_q_compare_returns_error() -> UInt32 {
        let result = RuntimeString::Q::compare(0, 0);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_q_find_returns_error() -> UInt32 {
        let result = RuntimeString::Q::find(0, 0);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_phi_len() -> UInt32 {
        let result = RuntimeString::Phi::len(0);
        return 1;
    }
    
    proc test_phi_concat_returns_error() -> UInt32 {
        let result = RuntimeString::Phi::concat(0, 0);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_phi_compare_returns_error() -> UInt32 {
        let result = RuntimeString::Phi::compare(0, 0);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc test_phi_find_returns_error() -> UInt32 {
        let result = RuntimeString::Phi::find(0, 0);
        if result == 100 {
            return 1;
        }
        return 0;
    }
    
    proc run_all_tests() -> UInt32 {
        let passed = 0;
        
        passed = passed + RuntimeStringTests::test_k_len();
        passed = passed + RuntimeStringTests::test_k_concat();
        passed = passed + RuntimeStringTests::test_k_compare();
        passed = passed + RuntimeStringTests::test_k_find();
        passed = passed + RuntimeStringTests::test_k_substring();
        passed = passed + RuntimeStringTests::test_k_to_upper();
        passed = passed + RuntimeStringTests::test_k_to_lower();
        passed = passed + RuntimeStringTests::test_q_len();
        passed = passed + RuntimeStringTests::test_q_concat_returns_error();
        passed = passed + RuntimeStringTests::test_q_compare_returns_error();
        passed = passed + RuntimeStringTests::test_q_find_returns_error();
        passed = passed + RuntimeStringTests::test_phi_len();
        passed = passed + RuntimeStringTests::test_phi_concat_returns_error();
        passed = passed + RuntimeStringTests::test_phi_compare_returns_error();
        passed = passed + RuntimeStringTests::test_phi_find_returns_error();
        
        return passed;
    }
}
